# Caddy gets and renews the https certificates automatically (Let's Encrypt).
# It replaces any X-Forwarded-For a visitor sends, so the server's per-IP rate
# limits can't be fooled.

# The Glofly server: API + real-time connection.
{$API_DOMAIN} {
	encode zstd gzip

	# Glofly Control (the admin app) only answers from the admin's own network.
	# ADMIN_IPS in deploy/.env: addresses or ranges separated by spaces. Unset: nobody.
	# (The server checks the same list again.)
	# 0.8.2: requests from Control for iPhone carry X-Control-Device and are signed with the
	# approved phone's own key; they're let through from anywhere and the server checks the
	# signature (apps/server/src/admin/devices.ts). Anything without a good signature is refused there.
	@control_elsewhere {
		path /admin /admin/*
		not remote_ip {$ADMIN_IPS:127.0.0.1}
		not header X-Control-Device *
	}
	handle @control_elsewhere {
		header Content-Type application/json
		respond `{"error":"not_allowed_network","message":"Glofly Control only works from your home network."}` 403
	}

	reverse_proxy server:4000
}

# The website (the site/ folder in the repo).
{$SITE_DOMAIN} {
	encode zstd gzip

	# The pages people open from Glofly's emails (choose a new password, confirm an email,
	# finish setting up an account made in Glofly Control, join from a friend's invite) come
	# from the Glofly server, with its own security headers. Since 0.7.4 so do constellation invite
	# pages (glofly.app/c/<code>) and their pictures, and since 0.8.0 friend invite links
	# (glofly.app/i/<code>, with the photo and link preview picture).
	@account path /reset /confirm /welcome /join /c/* /i/*
	handle @account {
		reverse_proxy server:4000
	}

	handle {
		# Always the newest installer (each release also uploads Glofly-Setup.exe).
		redir /download https://glofly-updates.s3.us-east-2.amazonaws.com/Glofly-Setup.exe 302
		redir /download/windows https://glofly-updates.s3.us-east-2.amazonaws.com/Glofly-Setup.exe 302
		# The newest Mac test build (uploaded by the "Mac build" GitHub Action on each release).
		redir /download/mac https://glofly-updates.s3.us-east-2.amazonaws.com/Glofly-Mac.dmg 302
		# The newest Android APK (uploaded by hand until Glofly is on Google Play; site/android.html).
		redir /download/android https://glofly-updates.s3.us-east-2.amazonaws.com/Glofly-Android.apk 302
		header {
			Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; script-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			Strict-Transport-Security "max-age=31536000"
		}
		root * /srv/site
		# /terms and /privacy serve terms.html and privacy.html
		try_files {path} {path}.html
		file_server
	}
}

# Glofly in a browser (apps/web, copied into the chat_site volume by the "web" service).
# Plain files: the page signs in with the Glofly server at {$API_DOMAIN} (a cookie that page's
# script can never read). The Content-Security-Policy only lets it load its own files and talk to
# the Glofly server and LiveKit (calls), and show only one framed page: the server's Watch
# Together player (0.5.0).
{$WEB_DOMAIN} {
	encode zstd gzip
	header {
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://{$API_DOMAIN} https://i.ytimg.com https://media.giphy.com; font-src 'self'; media-src 'self' blob: mediastream: https://{$API_DOMAIN}; connect-src 'self' https://{$API_DOMAIN} wss://{$API_DOMAIN} wss://*.livekit.cloud https://*.livekit.cloud; worker-src 'self'; manifest-src 'self'; frame-src https://{$API_DOMAIN}; frame-ancestors 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000"
		Cross-Origin-Opener-Policy same-origin
		Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), fullscreen=(self), speaker-selection=(self), geolocation=(), payment=(), usb=(), serial=(), bluetooth=()"
		-Server
	}
	# Files with a fingerprint in their name never change; the page itself is always checked.
	@fingerprinted path /assets/* /twemoji/*
	header @fingerprinted Cache-Control "public, max-age=31536000, immutable"
	@page path / /index.html /sw.js /version.json /manifest.webmanifest
	header @page Cache-Control "no-cache"
	root * /srv/chat
	try_files {path} /index.html
	file_server
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
