# Live server settings. Copy to deploy/.env ON THE SERVER ONLY (chmod 600). Never commit it.
# Make a secret: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"

# The API address (its DNS A record points at this machine), e.g. api.glofly.app
API_DOMAIN=

# Amazon RDS (not public; only this machine can reach it)
DATABASE_URL=postgres://glofly:<password>@<rds-endpoint>:5432/glofly
DATABASE_POOL_MAX=10

# Redis runs next to the server in Docker
REDIS_PASSWORD=

# Files: private S3 bucket; the machine's AWS role gives access (no keys here)
STORAGE_BUCKET=
AWS_REGION=us-east-2

# Emails (Amazon SES in AWS_REGION; sending is set up in docker-compose.yml). Optional:
# EMAIL_FROM=Glofly <noreply@glofly.app>

# Calls (LiveKit Cloud → your project → Settings → API keys)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Glofly Control (admin app). Without ADMIN_KEY, /admin answers "not set up yet".
# ADMIN_KEY: 64 hex characters, encrypts the authenticator secret in the database. Make one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ADMIN_IPS: your home network's public address (what https://api.ipify.org shows at home);
# several separated by spaces; IPv4 ranges like 203.0.113.0/24 work too. Change it if your
# home address changes, then: docker compose up -d
ADMIN_KEY=
ADMIN_IPS=

# Push notifications to the phone apps (Firebase Cloud Messaging). Firebase console → Project
# settings → Service accounts → Generate new private key → save it on the server as
# deploy/secrets/firebase.json (chmod 600). Leave empty to run without push notifications.
FCM_SERVICE_ACCOUNT_FILE=/run/glofly-secrets/firebase.json
# iPhone lock-screen calls (CallKit): Apple's push key (.p8) from Apple Developer → Keys, the same
# "Apple Push Notifications service" key uploaded to Firebase. Put it in deploy/secrets/ as apns.p8.
# Without these, iPhones still ring with a normal notification.
APNS_KEY_FILE=/run/glofly-secrets/apns.p8
APNS_KEY_ID=
APNS_TEAM_ID=
# 0.9.0: Control for iPhone's alerts use the same Apple key (APNS_KEY_FILE, APNS_KEY_ID, APNS_TEAM_ID).
# Its app is com.glofly.control; set CONTROL_APNS_BUNDLE_ID only if you picked another bundle id.
CONTROL_APNS_BUNDLE_ID=

# GIFs (0.5.0) from GIPHY: developers.giphy.com → Create an App → API → the API key.
# The key stays on the server; leave empty and the GIF button says GIFs aren't set up yet.
GIPHY_API_KEY=
# "Glofly's day" for glows and birthday reminders (an IANA time zone). US Central if empty.
GLOFLY_TIME_ZONE=America/Chicago
