# Copy to .env and fill in. Never commit .env.
# Make a password: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
POSTGRES_PASSWORD=
REDIS_PASSWORD=
DATABASE_URL=postgres://glofly:<POSTGRES_PASSWORD>@127.0.0.1:5432/glofly
REDIS_URL=redis://:<REDIS_PASSWORD>@127.0.0.1:6379

# Calls (LiveKit Cloud → your project → Settings → API keys). Leave empty to run without calls.
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Glofly Control (admin app). ADMIN_KEY: 64 hex characters, make one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# then run: npm run admin:setup -w apps/server -- <your username>
# ADMIN_IPS: leave empty while developing (only this PC can use Control).
ADMIN_KEY=
ADMIN_IPS=
