# Copy to .env and fill in. Never commit .env.
# Make a password: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
POSTGRES_PASSWORD=
REDIS_PASSWORD=
DATABASE_URL=postgres://glofly:<POSTGRES_PASSWORD>@127.0.0.1:5432/glofly
REDIS_URL=redis://:<REDIS_PASSWORD>@127.0.0.1:6379

# Calls (LiveKit Cloud → your project → Settings → API keys). Leave empty to run without calls.
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Glofly Control (admin app). ADMIN_KEY: 64 hex characters, make one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# then run: npm run admin:setup -w apps/server -- <your username>
# ADMIN_IPS: leave empty while developing (only this PC can use Control).
ADMIN_KEY=
ADMIN_IPS=

# Push notifications to phones (Firebase → Project settings → Service accounts → new private key).
# Point this at the key file, kept OUTSIDE the repo. Leave empty to run without push.
FCM_SERVICE_ACCOUNT_FILE=

# Glofly in a browser (apps/web). While developing: run `npm run dev -w apps/web` and open
# http://localhost:5180. Leave empty to keep the browser version off (the apps don't need it).
WEB_ORIGIN=http://localhost:5180

# GIFs (0.5.0) from GIPHY: developers.giphy.com → Create an App → API → the API key.
# The key stays on the server; leave empty and the GIF button says GIFs aren't set up yet.
GIPHY_API_KEY=
# 0.9.3 Settings → Connections and constellation Live alerts. Each is off until its keys are set.
# Steam: steamcommunity.com/dev/apikey (domain: your API address). Twitch: dev.twitch.tv/console →
# the same app as IGDB is fine (its OAuth Redirect URL must include <PUBLIC_API_URL>/connections/twitch/return).
# Kick: kick.com/settings/developer (redirect <PUBLIC_API_URL>/connections/kick/return, webhook
# <PUBLIC_API_URL>/hooks/kick, scopes user:read + events:subscribe). YouTube needs no key; with
# YOUTUBE_API_KEY (Google Cloud → YouTube Data API v3) people can also paste @handle links.
# Twitch and Kick only send live notices to an https address: PUBLIC_API_URL must be the real one.
STEAM_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
YOUTUBE_API_KEY=
# "Glofly's day" for glows and birthday reminders (an IANA time zone). US Central if empty.
GLOFLY_TIME_ZONE=America/Chicago
