# Copy to .env and fill in. Never commit .env.
# Make a password: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
POSTGRES_PASSWORD=
REDIS_PASSWORD=
DATABASE_URL=postgres://glofly:<POSTGRES_PASSWORD>@127.0.0.1:5432/glofly
REDIS_URL=redis://:<REDIS_PASSWORD>@127.0.0.1:6379

# Calls (LiveKit Cloud → your project → Settings → API keys). Leave empty to run without calls.
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
