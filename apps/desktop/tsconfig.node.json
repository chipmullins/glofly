{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "vite-twemoji.ts",
    "src/main/**/*",
    "src/preload/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "types": [
      "electron-vite/node"
    ],
    "paths": {
      "@glofly/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@glofly/shared/*": [
        "../../packages/shared/src/*"
      ]
    },
    "baseUrl": "."
  }
}
