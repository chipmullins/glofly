# Baked into installer builds (npm run build:win). Not secret: these are public addresses.
# npm run dev ignores this file (it uses localhost). apps/desktop/.env.production.local, if present,
# wins over it for installer builds (.env.local does NOT: Vite ranks .env.production above it).
MAIN_VITE_SERVER_URL=https://api.glofly.app
MAIN_VITE_UPDATES_URL=https://glofly-updates.s3.us-east-2.amazonaws.com
