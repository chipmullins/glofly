{
  "name": "@glofly/web",
  "private": true,
  "version": "1.0.0",
  "description": "Glofly in a browser (chat.glofly.app): the desktop app's screens with a browser bridge",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && vite build --config vite.sw.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.sw.json"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "livekit-client": "^2.22.3",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@twemoji/parser": "^17.0.2",
    "@twemoji/svg": "^15.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "emojibase-data": "^17.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
